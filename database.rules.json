{
  "rules": {
    ".read": false,
    ".write": false,
    "people": {
      ".read": true,
      ".write": false
    },
    "draw": {
      ".read": true,
      "version": {
        ".write": "newData.exists()",
        ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
      },
      "drawn": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.val() === true && root.child('people/' + $id).exists() && ((!root.child('draw/version').exists() && newData.parent().parent().child('version').val() === 1) || newData.parent().parent().child('version').val() === root.child('draw/version').val() + 1)"
        }
      },
      "taken": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.val() === true && root.child('people/' + $id).exists() && ((!root.child('draw/version').exists() && newData.parent().parent().child('version').val() === 1) || newData.parent().parent().child('version').val() === root.child('draw/version').val() + 1)"
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
